# Copy this file to .env.local and fill in the values.

# Postgres connection string. Locally: your own Postgres. In production: Neon,
# whose connection string ends in ?sslmode=require so the connection is
# encrypted. Keep that part.
DATABASE_URL="postgresql://user:password@localhost:5432/ali_porto"

# Better Auth. Generate a secret with: openssl rand -base64 32
# Use a different secret in production, and an https:// URL there.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated emails allowed into the dashboard. Must match the primary
# email of your GitHub account.
ADMIN_EMAILS=""

# Vercel Blob, for image uploads in the dashboard.
BLOB_READ_WRITE_TOKEN=""
